# Sandbox image for per-bug conda envs (enable with AUTODEBUG_CONDA=1).
#
# Adds micromamba to the base sandbox image. clone_into_volume uses it to build a
# Python env at the bug's EXACT version on the volume (micromamba create -p
# /workspace/env python=<version>), so pip finds matching wheels — old numpy/
# scipy/etc. install as binaries instead of failing to build from source — and
# every later stage runs the right interpreter via a PATH prepend.
#
# Only the CLONE container needs micromamba; the env it creates is self-contained,
# so the runtime can use the normal image. Building this one image and pointing
# AUTODEBUG_CONDA_IMAGE at it covers both.
#
# Build:
#   docker build -t autodebug-sandbox:latest        ./docker/sandbox
#   docker build -f docker/sandbox/Dockerfile.conda \
#                -t autodebug-sandbox-conda:latest   ./docker/sandbox

FROM autodebug-sandbox:latest

RUN apt-get update && apt-get install -y --no-install-recommends \
        curl bzip2 ca-certificates \
    && rm -rf /var/lib/apt/lists/*

# micromamba: a single static binary; no base env, no shell hook needed since we
# create envs by explicit prefix (-p /workspace/env).
RUN curl -Ls https://micro.mamba.pm/api/micromamba/linux-64/latest \
    | tar -xj -C /usr/local/bin --strip-components=1 bin/micromamba

# Shared package cache (mounted as a named volume at runtime) so each Python
# version + wheel is downloaded once across all bugs.
ENV MAMBA_ROOT_PREFIX=/opt/mamba

CMD ["bash"]
