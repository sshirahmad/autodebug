# ── LLM provider ──────────────────────────────────────────────────────────────
# Any provider supported by LangChain's init_chat_model works here.

# Anthropic (default)
# AUTODEBUG_MODEL=claude-sonnet-4-6
# AUTODEBUG_MODEL_PROVIDER=anthropic
# ANTHROPIC_API_KEY=your_key_here

# OpenAI
# AUTODEBUG_MODEL=gpt-4o
# AUTODEBUG_MODEL_PROVIDER=openai
# OPENAI_API_KEY=your_key_here

# OpenRouter (OpenAI-compatible, access to all providers)
AUTODEBUG_MODEL=anthropic/claude-3.5-sonnet
AUTODEBUG_MODEL_PROVIDER=openai
OPENAI_API_KEY=sk-or-v1-...
OPENAI_API_BASE=https://openrouter.ai/api/v1

# Ollama (local)
# AUTODEBUG_MODEL=llama3.1
# AUTODEBUG_MODEL_PROVIDER=ollama

# ── Fix Agent (optional: use a stronger model just for fix generation) ─────────
# AUTODEBUG_FIX_MODEL=claude-opus-4-7
# AUTODEBUG_FIX_MODEL_PROVIDER=anthropic

# ── GitHub ────────────────────────────────────────────────────────────────────
GITHUB_TOKEN=your_token_here

# ── Docker sandbox ────────────────────────────────────────────────────────────
SANDBOX_IMAGE=autodebug-sandbox:latest
SANDBOX_TIMEOUT_SECONDS=300
SANDBOX_MEM_LIMIT=512m
SANDBOX_NANO_CPUS=2000000000
