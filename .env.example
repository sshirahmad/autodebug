# ── LLM provider ──────────────────────────────────────────────────────────────
# Any provider supported by LangChain's init_chat_model works here.
# AUTODEBUG_MODEL / AUTODEBUG_MODEL_PROVIDER default to claude-sonnet-4-6 / anthropic.

# Anthropic (default)
# AUTODEBUG_MODEL=claude-sonnet-4-6
# AUTODEBUG_MODEL_PROVIDER=anthropic
# ANTHROPIC_API_KEY=your_key_here

# OpenAI
# AUTODEBUG_MODEL=gpt-4o
# AUTODEBUG_MODEL_PROVIDER=openai
# OPENAI_API_KEY=your_key_here

# OpenRouter (OpenAI-compatible, access to all providers)
AUTODEBUG_MODEL=anthropic/claude-3.5-sonnet
AUTODEBUG_MODEL_PROVIDER=openai
OPENAI_API_KEY=sk-or-v1-...
# Base URL for OpenAI-compatible providers. OPENAI_API_BASE is checked first,
# then OPENROUTER_BASE_URL (only applied when the provider is "openai").
OPENAI_API_BASE=https://openrouter.ai/api/v1
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Ollama (local)
# AUTODEBUG_MODEL=llama3.1
# AUTODEBUG_MODEL_PROVIDER=ollama

# Per-request timeout (seconds) for every LLM call. A stalled provider connection
# raises (then gets retried) instead of blocking forever on a socket read — which
# also keeps Ctrl+C working. Set 0 to disable. Default 120.
# AUTODEBUG_MODEL_TIMEOUT=120

# ── Fix Agent (optional: use a stronger model just for fix generation) ─────────
# AUTODEBUG_FIX_MODEL=claude-opus-4-7
# AUTODEBUG_FIX_MODEL_PROVIDER=anthropic

# ── Adversarial audit (LLM-as-judge) ──────────────────────────────────────────
# A cheap dedicated model reviews the repro and the fix before they're accepted,
# flagging a too-weak reproduction or a fix that masks the symptom. It only
# rejects on non-final attempts (the last attempt is always accepted), so it can
# never block the pipeline outright. Plain-text verdict — any model works.
# AUTODEBUG_JUDGE=1
# AUTODEBUG_JUDGE_MODEL=openai/gpt-4o-mini
# AUTODEBUG_JUDGE_PROVIDER=openai

# ── Retry escalation (optional) ───────────────────────────────────────────────
# On an agent's internal RETRY (the cheap base model failed the first attempt),
# escalate to this stronger model. Unset = keep using the base model on retries.
# AUTODEBUG_RETRY_MODEL=claude-opus-4-7
# AUTODEBUG_RETRY_MODEL_PROVIDER=anthropic

# ── Orchestration ─────────────────────────────────────────────────────────────
# Manager agent (FSM "brain") runs when config/agents/manager.json exists.
# Set to 0 to fall back to the classic linear repro→bisect→root_cause→fix pipeline.
# AUTODEBUG_MANAGER=1

# Prompt optimization: on each agent retry, LangMem rewrites the system prompt
# from the failed attempt's trajectory. Set to 0 to disable.
# AUTODEBUG_PROMPT_OPTIM=1
# The optimizer makes a structured-output (tool_choice) call, which some agent
# models can't do (some OpenRouter routes 404 "No endpoints found that support ...
# tool_choice"). So it runs on a SEPARATE, dedicated model — set it here. Must
# support tool_choice. Defaults to openai/gpt-4o-mini; provider falls back to the
# agent's provider if unset.
# AUTODEBUG_PROMPT_OPTIM_MODEL=openai/gpt-4o-mini
# AUTODEBUG_PROMPT_OPTIM_PROVIDER=openai

# Context summarization: older turns are summarized once history exceeds the
# token trigger; the most recent N messages are kept verbatim.
# AUTODEBUG_SUMMARIZE_TRIGGER_TOKENS=120000
# AUTODEBUG_SUMMARIZE_KEEP_MESSAGES=20

# ── Memory (cross-run learning) ───────────────────────────────────────────────
# Memories are ALWAYS written (the corpus grows every run). This flag gates only
# RECALL: when =1, agents search past memories; when =0 (default) they don't, so
# you get a clean, reproducible baseline with no recall influence.
# AUTODEBUG_MEMORY_ENABLED=0
# AUTODEBUG_MEMORY_MODEL=openrouter/owl-alpha
# Provider for the memory model. Defaults to the agent's provider
# (AUTODEBUG_MODEL_PROVIDER); set it only when the memory model needs a different
# route (e.g. agent on Anthropic but memory on an OpenRouter model).
# AUTODEBUG_MEMORY_PROVIDER=openai
# AUTODEBUG_EMBED_MODEL=huggingface:sentence-transformers/all-MiniLM-L6-v2
# AUTODEBUG_EMBED_DIMS=384

# ── Tracing (Phoenix / OpenTelemetry; off by default) ─────────────────────────
# AUTODEBUG_PHOENIX_ENABLED=false
# AUTODEBUG_PHOENIX_ENDPOINT=http://localhost:6006

# ── GitHub ────────────────────────────────────────────────────────────────────
GITHUB_TOKEN=your_token_here

# ── Docker sandbox ────────────────────────────────────────────────────────────
SANDBOX_IMAGE=autodebug-sandbox:latest
SANDBOX_TIMEOUT_SECONDS=300
SANDBOX_MEM_LIMIT=512m
SANDBOX_NANO_CPUS=2000000000
